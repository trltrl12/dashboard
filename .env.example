# Copy to .env.local for local dev, and set the same vars in Netlify
# (Site settings -> Environment variables).
#
# When BOTH are present, the app reads real data from Supabase.
# When absent, it falls back to the built-in deterministic mock data.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed to RUN the Windsor import script (scripts/import-windsor.mjs).
# Never expose these to the browser / never set them in Netlify's public build.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
WINDSOR_API_KEY=your-windsor-api-key

# Required for the AI Analysis panel (Claude reads all your tables and answers questions)
# Get this from https://console.anthropic.com -> API Keys
# Add to Netlify: Site settings -> Environment variables -> ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional: anchor the date-range presets to a fixed date instead of "today".
# Useful for viewing historical data. Leave unset in production.
# NEXT_PUBLIC_DATA_ANCHOR_DATE=2025-09-16
